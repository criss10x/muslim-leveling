[{"ayah": 1, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ", "translation": "Katakanlah: \"Hai orang-orang kafir,", "latin": "Qul yaa-ai yuhal kaafiroon"}, {"ayah": 2, "arabic": "لَآ أَعْبُدُ مَا تَعْبُدُونَ", "translation": "Aku tidak akan menyembah apa yang kamu sembah.", "latin": "Laa a'budu ma t'abudoon"}, {"ayah": 3, "arabic": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ", "translation": "Dan kamu bukan penyembah Tuhan yang aku sembah.", "latin": "Wa laa antum 'aabidoona maa a'bud"}, {"ayah": 4, "arabic": "وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ", "translation": "Dan aku tidak pernah menjadi penyembah apa yang kamu sembah,", "latin": "Wa laa ana 'abidum maa 'abattum"}, {"ayah": 5, "arabic": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ", "translation": "dan kamu tidak pernah (pula) menjadi penyembah Tuhan yang aku sembah.", "latin": "Wa laa antum 'aabidoona ma a'bud"}, {"ayah": 6, "arabic": "لَكُمْ دِينُكُمْ وَلِىَ دِينِ", "translation": "Untukmu agamamu, dan untukkulah, agamaku\".", "latin": "Lakum deenukum wa liya deen."}]