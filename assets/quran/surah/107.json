[{"ayah": 1, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ", "translation": "Tahukah kamu (orang) yang mendustakan agama?", "latin": "Ara-aital lazee yu kazzibu bid deen"}, {"ayah": 2, "arabic": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ", "translation": "Itulah orang yang menghardik anak yatim,", "latin": "Fa zaalikal lazi yadu'ul-yateem"}, {"ayah": 3, "arabic": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "translation": "dan tidak menganjurkan memberi makan orang miskin.", "latin": "Wa la ya huddu 'alaa ta'amil miskeen"}, {"ayah": 4, "arabic": "فَوَيْلٌۭ لِّلْمُصَلِّينَ", "translation": "Maka kecelakaanlah bagi orang-orang yang shalat,", "latin": "Fa wai lul-lil mu salleen"}, {"ayah": 5, "arabic": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ", "translation": "(yaitu) orang-orang yang lalai dari shalatnya,", "latin": "Al lazeena hum 'an salaatihim sahoon"}, {"ayah": 6, "arabic": "ٱلَّذِينَ هُمْ يُرَآءُونَ", "translation": "orang-orang yang berbuat riya,", "latin": "Al lazeena hum yuraa-oon"}, {"ayah": 7, "arabic": "وَيَمْنَعُونَ ٱلْمَاعُونَ", "translation": "dan enggan (menolong dengan) barang berguna.", "latin": "Wa yamna'oonal ma'oon"}]