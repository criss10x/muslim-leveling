<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget home screen: HUD sholat wajib hari ini.

  Bahasa visual mengikuti DESIGN.md (Night Watch):
    - kartu #121816 di kanvas, radius 16, tanpa bayangan, tanpa garis tepi
    - tiga sinyal saja: jade #34D399 = sudah dikerjakan, sian #00E1EF = waktu
      yang sedang berjalan, redup = belum. Emas tidak dipakai: widget tidak
      pernah memberi hadiah.
    - tipografi app yang sebenarnya: Sora untuk angka dan nama sholat,
      JetBrains Mono kapital untuk label HUD (The Readout Rule).

  HANYA view yang diizinkan RemoteViews. Tidak ada <View>, tidak ada <include>,
  tidak ada kelas custom: semuanya gagal di proses launcher tanpa error build.
  Aksen memakai FrameLayout berisi background.

  Semua teks dikosongkan: isinya dari snapshot Flutter (4 bahasa).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Kepala: logo (tanda pemilik, sengaja netral) + label HUD + jam. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_logo" />

        <TextView
            android:id="@+id/label_now"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:fontFamily="@font/jetbrains_mono_bold"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:textColor="#85948C"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/clock_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:fontFamily="@font/jetbrains_mono_bold"
            android:letterSpacing="0.10"
            android:textColor="#85948C"
            android:textSize="9sp" />

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_bold"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#85948C"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Sholat yang sedang berjalan: nama + jam sebagai satu unit. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/now_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/sora_bold"
            android:maxLines="1"
            android:textColor="#00E1EF"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/now_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:fontFamily="@font/sora_bold"
            android:gravity="bottom"
            android:maxLines="1"
            android:textColor="#00E1EF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Sholat berikutnya: redup, satu baris. -->
    <TextView
        android:id="@+id/next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/jakarta_regular"
        android:maxLines="1"
        android:textColor="#85948C"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"
        android:background="#3C4A43" />

    <!-- Lima sholat wajib, urut waktu. Tiap sel: nama (mono kapital), jam
         (Sora), lalu bilah status 3dp. Bilah adalah satu-satunya pembawa status
         di baris ini, jadi kelima kolom tetap tenang dibandingkan. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name_subuh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textColor="#85948C"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/time_subuh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/sora_bold"
                android:maxLines="1"
                android:textColor="#DCEDE5"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/bar_subuh"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#4E5F57" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name_dzuhur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textColor="#85948C"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/time_dzuhur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/sora_bold"
                android:maxLines="1"
                android:textColor="#DCEDE5"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/bar_dzuhur"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#4E5F57" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name_ashar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textColor="#85948C"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/time_ashar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/sora_bold"
                android:maxLines="1"
                android:textColor="#DCEDE5"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/bar_ashar"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#4E5F57" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name_maghrib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textColor="#85948C"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/time_maghrib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/sora_bold"
                android:maxLines="1"
                android:textColor="#DCEDE5"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/bar_maghrib"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#4E5F57" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name_isya"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textColor="#85948C"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/time_isya"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/sora_bold"
                android:maxLines="1"
                android:textColor="#DCEDE5"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/bar_isya"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#4E5F57" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
